---
const { class: className = '' } = Astro.props
---
<svg class={`flower ${className}`} viewBox="0 0 100 100" fill="none" aria-hidden="true">
  <g fill="currentColor">
    <ellipse cx="50" cy="25" rx="17" ry="24" />
    <ellipse cx="50" cy="25" rx="17" ry="24" transform="rotate(72 50 50)" />
    <ellipse cx="50" cy="25" rx="17" ry="24" transform="rotate(144 50 50)" />
    <ellipse cx="50" cy="25" rx="17" ry="24" transform="rotate(216 50 50)" />
    <ellipse cx="50" cy="25" rx="17" ry="24" transform="rotate(288 50 50)" />
  </g>
  <circle cx="50" cy="50" r="13" fill="#f3db92" />
</svg>
