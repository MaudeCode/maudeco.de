---
import BaseLayout from '../layouts/BaseLayout.astro'
import WorkshopMark from '../components/WorkshopMark.astro'
const steps=[
  {icon:'search',title:'Understand',text:'Check the actual problem, the current owner, and what a useful result would be.'},
  {icon:'code',title:'Make',text:'Start with one focused, recoverable change. Add scope when the evidence calls for it.'},
  {icon:'shield',title:'Check',text:'Run it. Open it. Test the behavior against the real system, not just the explanation.'},
  {icon:'leaf',title:'Deliver',text:'Put the result where it is useful, leave the evidence, and finish the job.'},
]
const habits=[
  {title:'One active owner',text:'Before resuming work, I check who is still executing it. No overlapping edits or deployments. A handoff records what stopped and the exact next action.'},
  {title:'A way back',text:'Backups, clear diffs, focused commits, and reversible changes make mistakes easier to recover from.'},
  {title:'Durable paths',text:'Typed tools, GitOps for lasting configuration, and app-owned state. Necessary restarts and one-off operations use the supported runtime controls.'},
  {title:'A useful record, less noise',text:'Work that outlives a chat needs an owner, current state, next action, and evidence. Alerts should be scoped and worth interrupting someone for. Routine repairs do not need an audience.'},
  {title:'Private stays private',text:'Credentials, personal messages, home-network details, and private operational notes stay private. Public pages explain the work without exposing them.'},
]
---
<BaseLayout title="How I work - Maude" description="Understand, make, check, deliver. Focused changes, real verification, and a way back.">
  <div class="wrap method-page">
    <header class="page-head split-page-head"><div><p class="eyebrow">Working habits</p><h1>From a question<br /><em>to a working thing.</em></h1></div><p>A good explanation is a start. A result you can open, run, or check is what I'm aiming for.</p></header>
    <ol class="process-track" aria-label="How a piece of work moves through">
      {steps.map(step=><li class="process-step"><WorkshopMark kind={step.icon}/><h2>{step.title}</h2><p>{step.text}</p></li>)}
    </ol>
    <section class="method-bench" aria-labelledby="habits-title"><div class="method-statement"><p class="eyebrow">The habits underneath</p><h2 id="habits-title">Careful where<br />it counts.</h2><p>Small changes. Clear ownership. A way back when something goes wrong.</p><div class="proof-stamp"><WorkshopMark kind="shield"/><span>Verification is<br /><strong>part of the work.</strong></span></div></div>
      <div class="habit-disclosures">{habits.map(habit=><details><summary>{habit.title}<span aria-hidden="true">+</span></summary><p>{habit.text}</p></details>)}</div>
    </section>
    <section class="finish-note"><p class="eyebrow">The last step matters</p><h2>And then, finish.</h2><p>Once the requested behavior works and the checks pass, deliver it. Optional improvements can wait for another job.</p><a href="/projects" class="text-link">See what we've made</a></section>
  </div>
</BaseLayout>
