---
import BaseLayout from '../layouts/BaseLayout.astro'
import Flower from '../components/Flower.astro'
---
<BaseLayout title="Page not found - Maude" description="Gone to greener pastures. This page is missing. Find your way back to Maude's home page or Writing.">
  <section class="wrap lost-page" aria-labelledby="lost-title">
    <div class="lost-mark" aria-hidden="true"><span>4</span><Flower/><span>4</span><svg viewBox="0 0 340 80" fill="none"><path d="M8 59c48 20 86-52 136-36s52 46 87 25 49-29 99-14" stroke="currentColor" stroke-width="2" stroke-dasharray="3 8" stroke-linecap="round"/></svg></div>
    <div class="lost-copy"><p class="eyebrow">404 / Page not found</p><h1 id="lost-title">Gone to<br /><em>greener pastures.</em></h1><p>This page isn't here. There are still a few good places to graze.</p><nav class="lost-links" aria-label="Find your way back"><a class="text-link" href="/">Head home</a><a class="text-link" href="/blog">Browse the writing</a></nav></div>
  </section>
</BaseLayout>
<style>
  .lost-page{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;align-items:center;padding-block:70px 80px;min-height:500px}
  .lost-mark{position:relative;display:flex;align-items:center;justify-content:center;gap:.04em;font-family:Bricolage,sans-serif;font-size:clamp(100px,15vw,210px);font-weight:700;line-height:1;letter-spacing:-.07em;color:var(--mint)}
  .lost-mark :global(.flower){width:.55em;height:.55em;margin-inline:.04em;transform:rotate(-12deg)}
  .lost-mark>svg{position:absolute;top:100%;width:90%;height:60px;left:5%;color:var(--mint);opacity:.6}
  .lost-copy h1{font-size:clamp(42px,4.6vw,64px);margin:16px 0 24px}.lost-copy>p:not(.eyebrow){max-width:420px;font-size:19px;color:var(--text-dim);margin:0 0 22px}
  .lost-links{display:flex;flex-wrap:wrap;gap:12px 30px}.lost-links a{font-size:16px}
  @media(max-width:760px){.lost-page{grid-template-columns:1fr;gap:46px;padding-block:36px 45px;min-height:0}.lost-mark{font-size:120px;justify-self:start;gap:.06em}.lost-mark>svg{height:35px}.lost-copy h1{font-size:44px;margin-bottom:20px}.lost-copy>p:not(.eyebrow){font-size:17px}.lost-links{gap:8px 24px}.lost-links a{font-size:15px}}
</style>
